#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:113
msgid "Job"
msgstr "Tâche"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:121
msgid "Job Configuration"
msgstr "Configuration de la tâche"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:131
#: /home/ggraham/Projects/MtSync/src/views/job_view.cpp:228
msgid "Type"
msgstr "Type"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:140
msgid "Source (remote:path)"
msgstr "Source (distant:chemin)"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:149
msgid "Destination (remote:path)"
msgstr "Destination (distant:chemin)"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:158
msgid "File Include Filters (space-separated patterns)"
msgstr "Filtres d'inclusion de fichiers (modèles séparés par des espaces)"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:161
msgid "All files"
msgstr "Tous les fichiers"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:175
msgid "Dry Run"
msgstr "Essai à blanc"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:176
msgid ""
"Simulate the transfer without moving or modifying any files — useful for "
"previewing what would change before committing"
msgstr ""
"Simuler le transfert sans déplacer ni modifier aucun fichier — utile pour "
"prévisualiser ce qui changerait avant de lancer"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:183
msgid "Bi-directional sync"
msgstr "Synchronisation bidirectionnelle"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:184
msgid ""
"Synchronise changes in both directions so that new or modified files on "
"either side are propagated to the other; uses rclone bisync"
msgstr ""
"Synchroniser les modifications dans les deux sens afin que les fichiers "
"nouveaux ou modifiés de chaque côté soient propagés à l'autre ; utilise "
"rclone bisync"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:191
msgid "Force Deletes"
msgstr "Forcer les suppressions"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:192
msgid ""
"Allow bi-directional sync to propagate deletions. rclone's delete-safety "
"check is unreliable when run this way, so without this enabled ANY deletion "
"on either side — even a single file — will block the sync until you "
"intervene manually. Enabling this removes that protection entirely, "
"including for large accidental deletions."
msgstr ""
"Permettre à la synchronisation bidirectionnelle de propager les "
"suppressions. Le contrôle de sécurité des suppressions de rclone n'est pas "
"fiable dans ce mode : sans cette option, TOUTE suppression d'un côté — même "
"d'un seul fichier — bloquera la synchronisation jusqu'à votre intervention "
"manuelle. L'activer supprime entièrement cette protection, y compris pour "
"les suppressions accidentelles massives."

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:200
msgid "Enable Checksum"
msgstr "Activer la somme de contrôle"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:201
msgid ""
"Verify each transferred file's checksum against the source — slower but "
"guarantees bit-perfect copies"
msgstr ""
"Vérifier la somme de contrôle de chaque fichier transféré par rapport à la "
"source — plus lent mais garantit des copies identiques au bit près"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:208
msgid "Mount at Start-up"
msgstr "Monter au démarrage"

