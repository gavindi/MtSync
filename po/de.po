#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:131
#: /home/ggraham/Projects/MtSync/src/views/job_view.cpp:229
#: /home/ggraham/Projects/MtSync/src/views/log_view_dialog.cpp:62
msgid "Type"
msgstr "Typ"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:140
msgid "Source (remote:path)"
msgstr "Quelle (remote:Pfad)"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:149
msgid "Destination (remote:path)"
msgstr "Ziel (remote:Pfad)"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:158
msgid "File Include Filters (space-separated patterns)"
msgstr "Datei-Einschlussfilter (durch Leerzeichen getrennte Muster)"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:161
msgid "All files"
msgstr "Alle Dateien"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:175
msgid "Dry Run"
msgstr "Probelauf"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:176
msgid ""
"Simulate the transfer without moving or modifying any files — useful for "
"previewing what would change before committing"
msgstr ""
"Den Transfer simulieren, ohne Dateien zu verschieben oder zu verändern — "
"nützlich, um vorab zu sehen, was sich ändern würde"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:183
msgid "Bi-directional sync"
msgstr "Bidirektionale Synchronisierung"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:184
msgid ""
"Synchronise changes in both directions so that new or modified files on "
"either side are propagated to the other; uses rclone bisync"
msgstr ""
"Änderungen in beide Richtungen synchronisieren, sodass neue oder geänderte "
"Dateien auf beiden Seiten übertragen werden; verwendet rclone bisync"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:191
msgid "Force Deletes"
msgstr "Löschungen erzwingen"

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:192
msgid ""
"Allow bi-directional sync to propagate deletions. rclone's delete-safety "
"check is unreliable when run this way, so without this enabled ANY deletion "
"on either side — even a single file — will block the sync until you "
"intervene manually. Enabling this removes that protection entirely, "
"including for large accidental deletions."
msgstr ""
"Erlauben, dass die bidirektionale Synchronisierung Löschungen überträgt. Die "
"Löschsicherheitsprüfung von rclone ist in diesem Modus unzuverlässig; ohne "
"diese Option blockiert JEDE Löschung auf einer Seite — selbst eine einzelne "
"Datei — die Synchronisierung, bis Sie manuell eingreifen. Wenn diese Option "
"aktiviert ist, entfällt dieser Schutz vollständig, auch bei großen "
"versehentlichen Löschungen."

#: /home/ggraham/Projects/MtSync/src/views/job_edit_dialog.cpp:200
msgid "Enable Checksum"
msgstr "Prüfsumme aktivieren"

